# Guest Posting AI - Backend Configuration
PROJECT_NAME="Guest Posting AI API"
API_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to SQLite for instant local dev, or PostgreSQL)
DATABASE_URL="sqlite:///./guest_posting_ai.db"
# DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/guest_posting_ai"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Search Engine Provider Configuration (Step 10)
# Supported providers: serpapi, google_custom_search, brave, valueserp
SEARCH_PROVIDER="serpapi"
SEARCH_API_KEY="your_search_api_key_here"
SEARCH_ENGINE_ID="your_google_custom_search_cx_if_using_google"
SEARCH_TIMEOUT_SECONDS=15.0

# Website Crawler Configuration (Step 12)
CRAWLER_USER_AGENT="GuestPostingAI/1.0 (+https://github.com/guest-posting-ai)"
CRAWLER_TIMEOUT_SECONDS=15.0
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_MAX_REDIRECTS=5

# AI Verification / Gemini Configuration (Step 15)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30.0

# Authentication Configuration (Step 21)
JWT_SECRET_KEY="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Configuration (Google Identity Services / OAuth2)
GOOGLE_CLIENT_ID="your_google_oauth_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret_here"

# Parallel Processing Configuration (Step 23)
MAX_CONCURRENT_WEBSITES=5
PIPELINE_DEFAULT_CONCURRENCY=5
PIPELINE_MAX_CONCURRENCY_LIMIT=20

# Caching, Rate Limiting & Retry Configuration (Step 24)
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
MAX_CONCURRENT_HTTP_REQUESTS=10
MAX_CONCURRENT_AI_REQUESTS=3
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=10.0
