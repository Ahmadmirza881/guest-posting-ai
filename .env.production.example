# ==============================================================================
# Guest Posting AI — Production Environment Configuration Template
# ==============================================================================

# Core App Settings
PROJECT_NAME="Guest Posting AI"
API_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="production"
DEBUG=False

# Fullstack Single-Service Serving
SERVE_FRONTEND=True
FRONTEND_DIST_DIR="./dist"

# Database Configuration
# Default is persistent SQLite, or connect to managed PostgreSQL:
DATABASE_URL="sqlite:///./guest_posting_ai.db"
# DATABASE_URL="postgresql+psycopg://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres"

# CORS Configuration
# Include your frontend production URL (and custom domain if any)
ALLOWED_ORIGINS="https://your-domain.onrender.com,https://your-domain.vercel.app"

# Authentication Security (REQUIRED IN PRODUCTION)
# Must be a secure, random secret of at least 32 characters
JWT_SECRET_KEY="generate-a-secure-random-32-char-string-for-jwt-signing"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (Optional - only if Google Login is configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Engine / Gemini API (REQUIRED for website analysis & rating)
GEMINI_API_KEY="your_production_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30.0

# Search Engine Provider (REQUIRED for web search)
# Supported: tavily, serpapi, google_custom_search, brave, valueserp
SEARCH_PROVIDER="tavily"
SEARCH_API_KEY="your_production_search_api_key"
TAVILY_API_KEY="your_production_tavily_api_key"

# Crawler & Concurrency Settings
CRAWLER_USER_AGENT="GuestPostingAI/1.0 (+https://guest-posting-ai)"
CRAWLER_TIMEOUT_SECONDS=15.0
MAX_CONCURRENT_WEBSITES=5
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
